msgstr "Todos"

#: usr/share/por-ai/ui/preferences.py:54
msgid ""
"Qualquer provedor, inclusive os que retêm e treinam com os prompts (a "
"política da sua conta no site do OpenRouter continua valendo)."
msgstr ""
"Cualquier proveedor, incluso los que retienen y entrenan con los prompts (la"
" política de tu cuenta en el sitio de OpenRouter sigue vigente)."

#: usr/share/por-ai/ui/preferences.py:56 usr/share/por-ai/ui/window.py:2570
msgid "Sem treino"
msgstr "Sin entrenamiento"

#: usr/share/por-ai/ui/preferences.py:57
