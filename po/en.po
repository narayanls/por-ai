#: usr/share/por-ai/core/openrouter.py:405
#, python-brace-format
msgid "Falha ao contatar {provider}: {error}"
msgstr "Failed to contact {provider}: {error}"

#: usr/share/por-ai/core/openrouter.py:172
#: usr/share/por-ai/core/openrouter.py:226
#, python-brace-format
msgid "{provider} retornou JSON inválido."
msgstr "{provider} returned invalid JSON."

#: usr/share/por-ai/core/openrouter.py:230
msgid "O provedor retornou uma resposta vazia."
msgstr "The provider returned an empty response."

#: usr/share/por-ai/core/openrouter.py:253
#: usr/share/por-ai/core/openrouter.py:423
msgid ""
"O modelo esgotou o limite de tokens pensando e não chegou a gerar a resposta"
" final (finish_reason=error). Aumente o limite de tokens em Preferências, "
"reduza o esforço de raciocínio, reduza o tamanho do prompt, ou tente um "
"modelo com raciocínio menos verboso."
msgstr ""
"The model used up its token limit while thinking and never produced the "
"final answer (finish_reason=error). Raise the token limit in Preferences, "
"lower the reasoning effort, shorten the prompt, or try a model with less "
"verbose reasoning."

#: usr/share/por-ai/core/openrouter.py:261
#: usr/share/por-ai/core/openrouter.py:431
#, python-brace-format
msgid ""
"O modelo só retornou raciocínio interno, sem uma resposta final "
"(finish_reason={reason})."
msgstr ""
"The model only returned internal reasoning, with no final answer "
"(finish_reason={reason})."

#: usr/share/por-ai/core/openrouter.py:263
#: usr/share/por-ai/core/openrouter.py:433
