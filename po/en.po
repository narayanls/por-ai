#: usr/share/por-ai/core/assistant.py:383
msgid "retenção zero"
msgstr "zero data retention"

#: usr/share/por-ai/core/assistant.py:385
msgid "sem treino com os seus dados"
msgstr "no training on your data"

#: usr/share/por-ai/core/assistant.py:388
#, python-brace-format
msgid ""
"Nenhum provedor deste modelo atende ao filtro de privacidade ({level}). "
"Escolha outro modelo ou afrouxe o filtro em Preferências ▸ OpenRouter ▸ "
"Privacidade."
msgstr ""
"None of this model's providers meet the privacy filter ({level}). Choose "
"another model or relax the filter in Preferences ▸ OpenRouter ▸ Privacy."

#: usr/share/por-ai/core/assistant.py:599
#, python-brace-format
msgid ""
"Configure a chave da API da Maritaca em Preferências para usar o modelo "
"{model}."
msgstr "Set up the Maritaca API key in Preferences to use the model {model}."

#: usr/share/por-ai/core/assistant.py:604
#, python-brace-format
msgid ""
"Configure a chave da API do OpenRouter em Preferências para usar o modelo "
"{model}."
msgstr ""
"Set up the OpenRouter API key in Preferences to use the model {model}."

#: usr/share/por-ai/core/assistant.py:616
msgid ""
"A pesquisa na web só está disponível nos modelos do OpenRouter. Desative o "
"botão de pesquisa ou escolha outro modelo."
msgstr ""
"Web search is only available for OpenRouter models. Turn off the search "
"button or choose another model."

#: usr/share/por-ai/core/assistant.py:624
msgid ""
"A pesquisa na web não funciona com modelos de geração de imagem. Desative o "
"botão de pesquisa e envie de novo."
msgstr ""
"Web search does not work with image generation models. Turn off the search "
"button and send again."

#: usr/share/por-ai/core/assistant.py:630
#, python-brace-format
msgid ""
"O modelo {model} não aceita ferramentas (tools), então não consegue usar a "
"pesquisa na web. Escolha outro modelo ou desative o botão de pesquisa."
msgstr ""
"The model {model} does not accept tools, so it cannot use web search. Choose"
" another model or turn off the search button."

#: usr/share/por-ai/core/assistant.py:746
msgid "Cancelado pelo usuário."
msgstr "Cancelled by the user."

#: usr/share/por-ai/core/assistant.py:838
msgid "Nenhum provedor configurado."
msgstr "No provider configured."

#: usr/share/por-ai/core/assistant.py:881
#, python-brace-format
msgid ""
"Não foi possível obter a lista de provedores com retenção zero, então o "
"catálogo não foi atualizado: {error}"
msgstr ""
"Could not get the list of zero data retention providers, so the catalog was "
"not updated: {error}"

